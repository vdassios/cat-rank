---
import LikeButton from '../../../../components/LikeButton.astro';
import { db, rawDb } from '../../../../db/connection';
import { cats } from '../../../../db/schema';
import { eq } from 'drizzle-orm';
import { checkOrigin } from '../../../../lib/csrf';
import { createIpUaHash } from '../../../../lib/auth';

export const partial = true;
export const prerender = false;

if (!checkOrigin(Astro.request)) {
  return new Response('Forbidden', { status: 403 });
}

const id = Number(Astro.params.id);
if (!Number.isFinite(id)) {
  return new Response('Not Found', { status: 404 });
}

const catResults = db.select().from(cats).where(eq(cats.id, id)).limit(1).all();
if (catResults.length === 0) {
  return new Response('Not Found', { status: 404 });
}

const userToken = Astro.locals.userToken;
const ipUaHash = createIpUaHash(
  Astro.locals.clientIp,
  Astro.request.headers.get('user-agent') || '',
);

function isConstraintError(err: unknown): boolean {
  return String((err as { code?: string })?.code ?? '').startsWith('SQLITE_CONSTRAINT');
}

let liked = true;

try {
  rawDb.transaction(() => {
    rawDb
      .prepare('INSERT INTO votes (cat_id, user_token, ip_ua_hash) VALUES (?, ?, ?)')
      .run(id, userToken, ipUaHash);
    rawDb.prepare('UPDATE cats SET likes_count = likes_count + 1 WHERE id = ?').run(id);
  })();
} catch (err: unknown) {
  if (isConstraintError(err)) {
    liked = true;
  } else {
    throw err;
  }
}

const cat = db.select().from(cats).where(eq(cats.id, id)).limit(1).all()[0];
---

<LikeButton cat={cat} liked={liked} />
