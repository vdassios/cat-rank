---
import type { Cat } from '../db/schema';
import LikeButton from './LikeButton.astro';
import CommentList from './CommentList.astro';
import CommentForm from './CommentForm.astro';
import type { Comment } from '../db/schema';

interface Props {
  cat: Cat;
  liked: boolean;
  comments: Comment[];
  nextPage: number | null;
  canComment: boolean;
}

const { cat, liked, comments, nextPage, canComment } = Astro.props;
---

<img class="cat-modal-img" src={cat.imagePath} alt={cat.name} />
<div class="cat-modal-info">
  <div class="cat-modal-header">
    <h2 class="cat-modal-name">{cat.name}</h2>
    <LikeButton cat={cat} liked={liked} />
  </div>
</div>
<hr />
<div id="comment-list">
  <CommentList comments={comments} catId={cat.id} nextPage={nextPage} />
</div>
<div id="comment-form">
  {canComment ? <CommentForm catId={cat.id} /> : <p>You commented on this cat</p>}
</div>

<style>
  .cat-modal-img {
    width: 100%;
    max-height: 60vh;
    object-fit: contain;
    display: block;
    border-radius: 4px;
  }
  .cat-modal-info {
    padding: 1rem 0;
  }
  .cat-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .cat-modal-name {
    margin: 0;
  }
</style>
