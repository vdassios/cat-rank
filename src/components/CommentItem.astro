---
import type { Comment } from '../db/schema';

interface Props {
  comment: Comment;
}

const { comment } = Astro.props;
---

<div class="comment-item">
  <p class="comment-item-text">{comment.text}</p>
  <small class="comment-item-time">{comment.createdAt}</small>
</div>

<style>
  .comment-item {
    padding: 0.5rem 0;
    border-bottom: 1px solid #eee;
    font-size: 0.9rem;
  }
  .comment-item-text {
    margin: 0 0 0.25rem;
  }
  .comment-item-time {
    color: #888;
  }
</style>
